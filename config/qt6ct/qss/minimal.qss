/* Minimalist Flat Dark UI for Qt */
QWidget {
    background-color: #141414;
    color: #d6d6d6;
    selection-background-color: #2c2c2c;
    selection-color: #ffffff;
}

QMenuBar {
    background-color: #141414;
    border-bottom: 1px solid #222222;
    padding: 2px 4px;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 8px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #222222;
    color: #ffffff;
}

QMenu {
    background-color: #181818;
    border: 1px solid #282828;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 20px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #282828;
    color: #ffffff;
}

QToolBar {
    background-color: #141414;
    border: none;
    spacing: 4px;
    padding: 2px;
}

QToolButton {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    padding: 4px 8px;
}

QToolButton:hover {
    background-color: #222222;
}

QToolButton:pressed {
    background-color: #2a2a2a;
}

QPushButton {
    background-color: #202020;
    border: 1px solid #2a2a2a;
    border-radius: 6px;
    padding: 5px 14px;
    color: #d6d6d6;
}

QPushButton:hover {
    background-color: #282828;
    border: 1px solid #383838;
    color: #ffffff;
}

QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #333333;
    min-height: 20px;
    border-radius: 3px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 6px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #333333;
    min-width: 20px;
    border-radius: 3px;
}

QScrollBar::add-line, QScrollBar::sub-line,
QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
    border: none;
}
