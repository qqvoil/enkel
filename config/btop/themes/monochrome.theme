# ==========================================================
# BTOP Pure Neutral Monochrome Theme
# Strict R=G=B Neutral Grayscale Matching Kitty & Hyprland
# ==========================================================

# Main background, empty for terminal default (matches Kitty)
theme[main_bg]=""

# Main text color
theme[main_fg]="#c8c8c8"

# Title color for boxes
theme[title]="#efefef"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#ffffff"

# Background color of selected item in processes box
theme[selected_bg]="#2c2c2c"

# Foreground color of selected item in processes box
theme[selected_fg]="#ffffff"

# Color of inactive/disabled text
theme[inactive_fg]="#555555"

# Color of text appearing on top of graphs, i.e uptime and current network
theme[graph_text]="#777777"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#888888"

# Box outline colors (matches Hyprland inactive borders)
theme[cpu_box]="#303030"
theme[mem_box]="#303030"
theme[net_box]="#303030"
theme[proc_box]="#303030"
theme[div_line]="#262626"

# Temperature graph colors (pure monochrome gradient)
theme[temp_start]="#4a4a4a"
theme[temp_mid]="#8a8a8a"
theme[temp_end]="#dedede"

# CPU graph colors
theme[cpu_start]="#3d3d3d"
theme[cpu_mid]="#808080"
theme[cpu_end]="#f0f0f0"

# Mem/Disk free meter
theme[free_start]="#3d3d3d"
theme[free_mid]="#808080"
theme[free_end]="#f0f0f0"

# Mem/Disk cached meter
theme[cached_start]="#3d3d3d"
theme[cached_mid]="#808080"
theme[cached_end]="#f0f0f0"

# Mem/Disk available meter
theme[available_start]="#3d3d3d"
theme[available_mid]="#808080"
theme[available_end]="#f0f0f0"

# Mem/Disk used meter
theme[used_start]="#3d3d3d"
theme[used_mid]="#808080"
theme[used_end]="#f0f0f0"

# Download graph colors
theme[download_start]="#3d3d3d"
theme[download_mid]="#808080"
theme[download_end]="#f0f0f0"

# Upload graph colors
theme[upload_start]="#3d3d3d"
theme[upload_mid]="#808080"
theme[upload_end]="#f0f0f0"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#3d3d3d"
theme[process_mid]="#808080"
theme[process_end]="#f0f0f0"
